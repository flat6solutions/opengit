{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opengit",
  "description": "A CLI tool for managing Git",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "scripts": {
    "dev": "bun run --cwd packages/cli --conditions=browser src/index.tsx"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@opencode-ai/sdk": "latest"
  }
}
